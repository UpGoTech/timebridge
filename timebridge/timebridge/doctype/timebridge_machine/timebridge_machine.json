  {
   "fieldname": "connection_information",
   "fieldtype": "Tab Break",
   "label": "Connection"
  },
  {
   "description": "The device's own address on the network. For push devices this is informational \u2014 the device reaches us, not the other way round.",
   "fieldname": "ip_address",
   "fieldtype": "Data",
   "label": "IP Address",
   "reqd": 1
  },
  {
   "default": "4370",
   "depends_on": "eval:doc.sdk_type != 'ADMS'",
   "description": "Port we dial to reach the device. Not used by ADMS/push devices \u2014 those send to the app's own port instead.",
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port",
   "reqd": 1
  },
  {
   "default": "TCP/IP",
   "depends_on": "eval:doc.sdk_type != 'ADMS'",
   "fieldname": "communication_type",
   "fieldtype": "Select",
   "label": "Communication Type",
   "options": "TCP/IP\nUSB\nCloud API"
  },
  {
   "default": "PyZK",
   "description": "PyZK = we ask the device for data. ADMS = the device sends data to us on its own. Pick ADMS for eSSL push devices.",
   "fieldname": "sdk_type",
   "fieldtype": "Select",
   "label": "SDK Type",
   "options": "PyZK\nADMS\nMatrix\nCustom",
   "reqd": 1
  },
  {
   "default": "0",
   "depends_on": "eval:doc.sdk_type != 'ADMS'",
   "description": "ZK comm key, used only when dialling the device. Not used by ADMS/push devices.",
   "fieldname": "communication_password",
   "fieldtype": "Int",
   "label": "Communication Password (Comm Key)"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.sdk_type != 'ADMS'",
   "description": "Leave off for normal ZK devices (TCP). Tick only when the device refuses TCP but answers UDP on the same port \u2014 some K300 units do this on 4370.",
   "fieldname": "force_udp",
   "fieldtype": "Check",
   "label": "Use UDP"
  },
  {
   "fieldname": "status_information",
   "fieldtype": "Tab Break",
   "label": "Status"
  },
  {
   "default": "Disconnected",
   "description": "Set automatically. For push devices it reflects whether the device has been in touch recently, not whether it can be dialled.",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Connected\nDisconnected\nInactive"
  },
  {
   "description": "When this device last spoke to us. Written to the database rather than kept only in the cache, because clearing the cache would otherwise make a perfectly healthy device look as though it had never connected.",
   "fieldname": "last_contact_at",
   "fieldtype": "Datetime",
   "label": "Last Contact",
   "read_only": 1
  },
  {
   "default": "1",
   "description": "Clear this to park one machine without disabling the scheduler for all of them.",
   "fieldname": "sync_enabled",
   "fieldtype": "Check",
   "label": "Sync Enabled"
  },
  {
   "description": "Watermark for attendance sync. Punches at or before this time are not re-read.",
   "fieldname": "last_sync",
   "fieldtype": "Datetime",
   "label": "Last Attendance Sync",
   "read_only": 1
  },
  {
   "description": "Watermark for user sync, tracked separately from attendance.",
   "fieldname": "last_user_sync",
   "fieldtype": "Datetime",
   "label": "Last User Sync",
   "read_only": 1
  },
  {
   "description": "Latest attendance upload marker echoed to the device as Stamp on ADMS handshake. Updated from each accepted ATTLOG POST.",
   "fieldname": "adms_stamp",
   "fieldtype": "Data",
   "label": "ADMS Attendance Stamp",
   "read_only": 1
  },
  {
   "description": "Latest user/operation upload marker echoed as OPERLOGStamp on ADMS handshake. Updated from each accepted OPERLOG/USERINFO POST.",
   "fieldname": "adms_op_stamp",
   "fieldtype": "Data",
   "label": "ADMS Operation Stamp",
   "read_only": 1
  },
  {
   "default": "Auto",
   "description": "How to encode punch-time stamps when the device sends placeholder Stamp=9999. Auto infers from the stored cursor; default fallback matches Attendance PUSH §11.2 punch time (YYYY-MM-DD HH:MM:SS).",
   "fieldname": "adms_stamp_format",
   "fieldtype": "Select",
   "label": "ADMS Stamp Format",
   "options": "Auto\nAttendance DateTime\nUnix Timestamp\nISO DateTime\nCompact (YYYYMMDDHHMMSS)"
  },
  {
